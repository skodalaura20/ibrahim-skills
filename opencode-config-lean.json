{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true,
            "type": "local"
        },
        "sequential-thinking": {
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true,
            "type": "local"
        }
    },
    "provider": {
        "nvidia": {
            "models": {
                "z-ai/glm-5.3-flash": {
                    "variants": {
                        "fast": {
                            "reasoningEffort": "low"
                        },
                        "smart": {
                            "reasoningEffort": "max"
                        }
                    }
                }
            }
        }
    }
}