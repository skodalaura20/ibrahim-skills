{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true,
            "type": "local"
        },
        "memory": {
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "enabled": true,
            "type": "local"
        },
        "playwright": {
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ],
            "enabled": true,
            "type": "local"
        },
        "rea": {
            "command": [
                "cmd.exe",
                "/d",
                "/c",
                "npx",
                "-y",
                "rea-agents@6.7.0",
                "mcp"
            ],
            "enabled": true,
            "type": "local"
        },
        "sequential-thinking": {
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true,
            "type": "local"
        },
        "fetch": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-fetch"
            ],
            "enabled": true
        },
        "camoufox": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "camoufox-mcp-server@latest"
            ],
            "enabled": true
        },
        "figma-mcp-go": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@vkhanhqui/figma-mcp-go"
            ],
            "enabled": true
        }
    },
    "provider": {
        "nvidia": {
            "models": {
                "z-ai/glm-5.3-flash": {
                    "variants": {
                        "fast": {
                            "reasoningEffort": "low"
                        },
                        "smart": {
                            "reasoningEffort": "max"
                        }
                    }
                }
            }
        }
    }
}